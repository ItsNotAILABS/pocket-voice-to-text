{
  "name": "@itsnotailabs/pocket-voice",
  "version": "1.3.0",
  "description": "Voice that can converse, compile spoken intent into executable work, hand code/build/deploy jobs to POCKET, and report execution state with receipts.",
  "main": "src/node-entry.js",
  "exports": {
    ".": "./src/node-entry.js",
    "./business": "./src/business.js",
    "./personalities": "./src/personalities.js",
    "./turn": "./src/turn-detection.js",
    "./coding": "./src/coding-core.js",
    "./stt": "./src/stt-pocket.js",
    "./flows": "./src/agent-flows.js",
    "./studio": "./src/studio-contract.js",
    "./voice-state": "./src/voice-state.js",
    "./reality": "./src/reality-envelope.js",
    "./work-bridge": "./src/work-bridge.js"
  },
  "bin": {
    "pocket-voice-api": "./server/cli.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:verbose": "node --test --test-reporter=spec test/*.test.js",
    "api": "node server/api.js",
    "start": "node server/api.js",
    "saas": "SAAS_MODE=1 node server/api.js",
    "demo": "npx --yes serve . -p 5173"
  },
  "keywords": [
    "voice-api",
    "vad",
    "patient-listening",
    "speech-to-text",
    "text-to-speech",
    "voice-agent",
    "voice-coding",
    "voice-deploy",
    "execution-envelope",
    "realtime",
    "context-snap",
    "voice-studio",
    "voice-state",
    "consent",
    "open-source",
    "pocket"
  ],
  "author": "ItsNotAI Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsNotAILABS/pocket-voice-to-text.git"
  },
  "bugs": {
    "url": "https://github.com/ItsNotAILABS/pocket-voice-to-text/issues"
  },
  "homepage": "https://github.com/ItsNotAILABS/pocket-voice-to-text#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "server/",
    "assets/",
    "docs/",
    "voice-to-text.js",
    "ecosystem.surface.json",
    "LICENSE",
    "README.md",
    "DEVBOARD.md"
  ]
}
